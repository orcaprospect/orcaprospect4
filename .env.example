# ============================================================
# Orça Prospect — variáveis de ambiente
# Copie este arquivo para `.env.local` (desenvolvimento) e
# configure no painel da Vercel (produção). NUNCA commite `.env.local`.
# ============================================================

# --- Aplicação ---
# URL pública do app (usada em links e metadados)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo para assinar cookies de sessão (OBRIGATÓRIO em produção).
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# --- Banco de dados ---
# Padrão: armazenamento em arquivo JSON local (zero configuração, ideal p/ dev).
# Para PostgreSQL/Supabase: instale `npm i pg` e defina:
#   STORE=postgres
#   DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Depois aplique o schema: database/schema.sql
STORE=json
DATABASE_URL=
# Diretório do armazenamento JSON (modo local)
DATA_DIR=.data

# --- Fontes de dados (providers) ---
# Qual provider usar: auto | google | osm | demo | custom | none
#   auto = demo (se DEMO_MODE=true) > google > custom > osm
DATA_PROVIDER=auto

# Google Places API (New) — requer chave com a "Places API (New)" habilitada.
# Deixe vazio se não for usar. NUNCA exponha esta chave no frontend.
GOOGLE_MAPS_API_KEY=

# OpenStreetMap (Nominatim + Overpass) — API pública e gratuita.
# Padrão: true. Respeite as políticas de uso (rate limit).
OSM_ENABLED=true

# Modo demonstração: gera EMPRESAS FICTÍCIAS claramente identificadas
# ("DADOS DE DEMONSTRAÇÃO"). Ideal para explorar sem nenhuma API.
DEMO_MODE=false

# Provider customizado: endpoint próprio que retorna empresas em JSON.
# CUSTOM_PROVIDER_URL=https://sua-api.exemplo.invalid/empresas
# CUSTOM_PROVIDER_API_KEY=   (enviado no header X-Api-Key — server-side apenas)
CUSTOM_PROVIDER_URL=
CUSTOM_PROVIDER_API_KEY=

# Limite de empresas detalhadas por busca (Google usa paginação até este limite)
SEARCH_MAX_RESULTS=60
